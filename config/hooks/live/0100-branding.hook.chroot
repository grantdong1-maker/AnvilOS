#!/bin/sh
# Hook: AnvilOS identity + terminal banner files inside the image.
set -e

echo "hook: writing AnvilOS identity files"

# Legacy file name kept (gforge reads it); values now say AnvilOS.
printf 'ANVILOS_NAME=AnvilOS\nANVILOS_VERSION=1.0.0\nANVILOS_CODENAME=anvil\nBASE_DEBIAN=13 (trixie)\n' > /etc/anvilos-release
chmod 644 /etc/anvilos-release

install -d /usr/share/forge /var/lib/forge
cat > /usr/share/forge/banner.txt <<'EOF'
AnvilOS 1.0 (Hammer) -- Debian 13 base
tuned for gaming + AI training; try 'gforge status' or 'gforge doctor'
EOF
chmod 644 /usr/share/forge/banner.txt

cat > /etc/profile.d/70-forge-banner.sh <<'EOF'
if [ "$PS1" ] && [ -r /usr/share/forge/banner.txt ]; then
    cat /usr/share/forge/banner.txt
fi
EOF
chmod 644 /etc/profile.d/70-forge-banner.sh
