#!/bin/sh
# Hook: pre-register the Flathub remote so the live session and the installed
# system can immediately install game launchers (Heroic, Bottles, Lutris...).
set -e

if command -v flatpak >/dev/null 2>&1; then
    echo "hook: adding flathub remote"
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi
