#!/bin/sh
# Hook: AnvilOS visual branding inside the chroot.
# Runs at hook stage 0400, i.e. BEFORE 0900-kernel-consistency, so the final
# initramfs regen there also pulls in our Plymouth theme.
set -e

echo "hook: AnvilOS branding (os-release, SDDM, Plymouth, services)"

# ---------------------------------------------------------------- os-release
# Live-build copies our os-release files BEFORE package installation, so
# base-files can overwrite them in the chroot. Re-assert them here.
cat > /etc/os-release <<'EOF'
PRETTY_NAME="AnvilOS 1.0 (Hammer)"
NAME="AnvilOS"
VERSION="1.0 (Hammer)"
VERSION_ID="1.0"
VERSION_CODENAME=hammer
ID=anvilos
ID_LIKE=debian
HOME_URL="https://anvilos.invalid/"
SUPPORT_URL="https://anvilos.invalid/"
BUG_REPORT_URL="https://github.com/grantdong1-maker/AnvilOS/issues"
EOF
chmod 644 /etc/os-release

if [ -e /usr/lib/os-release ]; then
    cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="AnvilOS 1.0 (Hammer)"
NAME="AnvilOS"
VERSION="1.0 (Hammer)"
VERSION_ID="1.0"
VERSION_CODENAME=hammer
ID=anvilos
ID_LIKE=debian
HOME_URL="https://anvilos.invalid/"
SUPPORT_URL="https://anvilos.invalid/"
BUG_REPORT_URL="https://github.com/grantdong1-maker/AnvilOS/issues"
EOF
    chmod 644 /usr/lib/os-release
fi

# ------------------------------------------------- live-user display name
# Live-config creates the user with GECOS "Debian Live user"; the shipped
# anvilos-branding.service fixes it on boot (after live-config ran).
install -d /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/anvilos-branding.service \
    /etc/systemd/system/multi-user.target.wants/anvilos-branding.service

# --------------------------------------------------------------------- SDDM
install -d /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-anvilos-branding.conf <<'EOF'
[Theme]
Current=anvilos
EOF
# Breeze greeter: forge-glow wallpaper behind the login box, ember accent text.
# NOTE: key spellings in this file are lowercase; QSettings matches
# case-insensitively, but sed is case-sensitive.
if [ -f /usr/share/sddm/themes/breeze/theme.conf ]; then
    sed -i '/^[Bb]ackground=/s|=.*|=/usr/share/wallpapers/anvilos-lock/contents/images/1920x1080.png|' \
        /usr/share/sddm/themes/breeze/theme.conf
    sed -i '/^[Cc]olor=/s|=.*|=#d67a3c|' \
        /usr/share/sddm/themes/breeze/theme.conf
fi

# ------------------------------------------------------- avatars (anvil face)
# Two avatar worlds to overwrite:
#  - SDDM greeter: /usr/share/sddm/faces/*.face.icon
#  - Plasma lock screen / About Me: ~/.face, which new homes inherit from
#    /etc/skel/.face - that file ships as the Debian swirl SVG (package
#    desktop-base), so skel itself must be replaced, not just sddm faces.
#    (.face.icon in skel is a symlink -> .face, so fixing .face fixes both.)
if [ -r /usr/share/anvilos-art/avatar.png ]; then
    install -m 644 /usr/share/anvilos-art/avatar.png /usr/share/sddm/faces/.face.icon
    install -m 644 /usr/share/anvilos-art/avatar.png /usr/share/sddm/faces/forge.face.icon
    install -m 644 /usr/share/anvilos-art/avatar.png /usr/share/sddm/faces/root.face.icon
    install -m 644 /usr/share/anvilos-art/avatar.png /usr/share/sddm/themes/breeze/faces/.face.icon 2>/dev/null || true
    install -m 644 /usr/share/anvilos-art/avatar.png /etc/skel/.face
    # in case a home already exists at build time (normally created from skel):
    install -m 644 /usr/share/anvilos-art/avatar.png /home/forge/.face 2>/dev/null || true
    install -m 644 /usr/share/anvilos-art/avatar.png /home/forge/.face.icon 2>/dev/null || true
fi

# -------------------------------------------------- software center rebrand
# Discover is KDE's app; AnvilOS ships it as "AnvilOS Software" (icon comes
# from the anvilos icon theme override).
for d in org.kde.discover.desktop org.kde.discover.urlhandler.desktop; do
    [ -f /usr/share/applications/"$d" ] || continue
    sed -i -e 's/^Name=.*/Name=AnvilOS Software/' \
           -e 's/^GenericName=.*/GenericName=Software/' \
        /usr/share/applications/"$d"
done

# -------------------------------------------------- session startup splash
# The brief "Plasma made by KDE" screen between Plymouth and the desktop is
# the look-and-feel splash; swap in the AnvilOS one (package-owned path, so
# this must happen in a hook, not via includes).
LF_DIR=/usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/splash
if [ -d "$LF_DIR" ] && [ -r /usr/share/anvilos-art/Splash.qml ]; then
    install -m 644 /usr/share/anvilos-art/Splash.qml "$LF_DIR/Splash.qml"
fi

# ------------------------------------------------------------- Welcome Center
# Debian's plasma-welcome is Konqi-and-KDE-branded and not configurable;
# it is only a Recommends of plasma-desktop, so removing it is safe.
apt-get purge -y plasma-welcome >/dev/null 2>&1 || true
apt-get autoremove -y >/dev/null 2>&1 || true

# ------------------------------------------------------------------ Plymouth
if [ -f /usr/share/plymouth/themes/anvilos/anvilos.plymouth ]; then
    plymouth-set-default-theme anvilos || true
else
    plymouth-set-default-theme text || true
fi

echo "hook: AnvilOS branding done"
