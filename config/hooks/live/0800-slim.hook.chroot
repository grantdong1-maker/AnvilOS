#!/bin/sh
# Hook: strip fat from the --lite image (English locales, man/info pages,
# package docs except copyrights). Runs only for lite; build.sh disables it
# for gaming/full where the docs and locales are wanted.
set -e

echo "hook: slimming lite image"

# Locales: keep English (and C).
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
    ! -name 'en*' -exec rm -rf {} + 2>/dev/null || true
rm -rf /usr/share/help 2>/dev/null || true

# Man + info pages: the live image is not a documentation box.
rm -rf /usr/share/man /usr/share/info 2>/dev/null || true

# Package docs: keep copyright + changelog files only.
find /usr/share/doc -mindepth 1 -maxdepth 1 -type d | while read -r d; do
    find "$d" -mindepth 1 \
        ! -name 'copyright' ! -name 'LICENSE*' ! -name 'license*' \
        ! -name 'changelog*' ! -name 'NEWS*' -delete 2>/dev/null || true
done

apt-get clean

echo "hook: slimming done"
